rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Same two accounts as `allowedUids` in src/environments/environment.prod.ts.
    function isAllowed() {
      return request.auth != null
        && request.auth.uid in [
          'YKqfsHI3gQXVqi2KTpNNXTmfqfW2',
          '55FPbgc0qWXClKx2inHodw4g1D52'
        ];
    }

    // Projects are shared by every allowed user.
    match /projects/{projectId} {
      allow read, write: if isAllowed();
    }

    // Any allowed user can read tasks (the shared timeline); only the owner can change them.
    match /tasks/{taskId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && request.resource.data.uid == request.auth.uid;
      allow update: if isAllowed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAllowed() && resource.data.uid == request.auth.uid;
    }
  }
}
